      "-n",
      "s26-sess",
      "--no-profile",
      "--with-extension",
      "marion:S26_MCP_LOG=<RUNS>/session-resume-redeclare/mcp.jsonl python3 <REPO>/spikes/s26/mcp_report_server.py"
    ],
    "exit_code": 1
  },
  "session-resume": {
    "argv": [
      "run",
