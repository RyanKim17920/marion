      "--output-format",
      "stream-json",
      "-q",
      "-n",
      "s26-sess",
      "--no-profile",
      "--with-extension",
      "marion:S26_MCP_LOG=<RUNS>/session-first/mcp.jsonl python3 <REPO>/spikes/s26/mcp_report_server.py"
