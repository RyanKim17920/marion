  --output-format
  stream-json
env:
  QWEN_HOME=/state/x/config/home
  OPENAI_BASE_URL=http://127.0.0.1:8099/v1
  OPENAI_API_KEY=sk-fake
  OPENAI_MODEL=canned-1
  QWEN_CODE_LEGACY_MCP_BLOCKING=1
  QWEN_CODE_SUPPRESS_YOLO_WARNING=1
  QWEN_CODE_SKIP_UPDATE_CHECK_ONCE=true
file /state/x/config/home/settings.json:
{
  "mcpServers": {
    "marion": {
      "args": [
        "mcp"
      ],
      "command": "/bin/marion-supervisor",
      "env": {
        "MARION_AGENT_ID": "019f-root",
        "MARION_AGENT_TYPE": "claude",
        "MARION_AUTH": "canned",
        "MARION_BASE_URL": "http://127.0.0.1:8099/v1",
        "MARION_DEPTH": "0",
        "MARION_READY_FILE": "/state/x/mcp-ready",
        "MARION_REPO": "/repo",
        "MARION_STATE_DIR": "/state"
      }
    }
  },
  "memory": {
    "enableManagedAutoMemory": false
  }
}

