program: qwen
cwd: /wt
model: Some("canned-1")
session_mode: None
args:
  --yolo
  --core-tools
  mcp__marion__report
  --exclude-tools
  agent
  enter_worktree
  exit_worktree
  get_goal
  list_agents
  record_artifact
  report_findings
  send_message
