program: cline
cwd: /wt
model: Some("canned-1")
session_mode: None
args:
  --json
  -c
  /wt
  --config
  /state/x/config/cfg
  --data-dir
  /state/x/config/data
  --auto-approve
  true
  -m
  canned-1
  do the task
env:
  HOME=/state/x/config/home
  CLINE_DIR=/state/x/config/cfg
  CLINE_DATA_DIR=/state/x/config/data
  CLINE_MCP_SETTINGS_PATH=/state/x/config/cline_mcp_settings.json
  CLINE_NO_AUTO_UPDATE=1
file /state/x/config/cline_mcp_settings.json:
{
  "mcpServers": {
    "marion": {
      "transport": {
        "args": [
          "mcp"
        ],
        "command": "/bin/marion-supervisor",
        "env": {
          "MARION_AGENT_ID": "019f-root",
          "MARION_AGENT_TYPE": "claude",
          "MARION_AUTH": "canned",
          "MARION_BASE_URL": "http://127.0.0.1:8099/v1",
          "MARION_DEPTH": "0",
          "MARION_READY_FILE": "/state/x/mcp-ready",
          "MARION_REPO": "/repo",
          "MARION_STATE_DIR": "/state"
        },
        "type": "stdio"
      }
    }
  }
}
file /state/x/config/data/settings/providers.json:
