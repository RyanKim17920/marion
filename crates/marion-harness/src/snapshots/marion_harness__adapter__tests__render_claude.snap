---
source: crates/marion-harness/src/adapter.rs
expression: out
---
## canned headless
program: claude
cwd: /repo
model: Some("haiku")
session_mode: None
args:
  -p
  --output-format
  stream-json
  --input-format
  stream-json
  --verbose
  --tools
  
  --allowedTools
  mcp__marion__spawn,mcp__marion__status
  --permission-prompt-tool
  stdio
  --strict-mcp-config
  --mcp-config
  /state/x/config/mcp.json
  --setting-sources
  
  --settings
  {"disableAllHooks":true}
  --model
  haiku
env:
  CLAUDE_CONFIG_DIR=/state/x/config/claude-config
  ANTHROPIC_BASE_URL=http://127.0.0.1:8099
  DISABLE_AUTOUPDATER=1
file /state/x/config/mcp.json:
{
  "mcpServers": {
    "marion": {
      "args": [
        "mcp"
      ],
      "command": "/bin/marion-supervisor",
      "env": {
        "MARION_AGENT_ID": "019f-root",
        "MARION_AGENT_TYPE": "claude",
        "MARION_AUTH": "canned",
        "MARION_BASE_URL": "http://127.0.0.1:8099/v1",
        "MARION_DEPTH": "0",
        "MARION_READY_FILE": "/state/x/mcp-ready",
        "MARION_REPO": "/repo",
        "MARION_STATE_DIR": "/state"
      },
      "type": "stdio"
    }
  }
}

