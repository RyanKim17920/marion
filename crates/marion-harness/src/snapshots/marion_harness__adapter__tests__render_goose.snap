## canned headless
program: goose
cwd: /wt
model: Some("canned-1")
session_mode: None
args:
  run
  -t
  do the task
  --output-format
  stream-json
  -q
  --no-session
  --no-profile
  --with-extension
  marion:MARION_REPO=/repo MARION_STATE_DIR=/state MARION_AUTH=canned MARION_AGENT_ID=019f-root MARION_AGENT_TYPE=claude MARION_DEPTH=0 MARION_BASE_URL=http://127.0.0.1:8099/v1 MARION_READY_FILE=/state/x/mcp-ready /bin/marion-supervisor mcp
env:
  HOME=/state/x/config/home
  GOOSE_PROVIDER=openai
  GOOSE_MODEL=canned-1
  OPENAI_HOST=http://127.0.0.1:8099/v1
  OPENAI_BASE_PATH=chat/completions
  OPENAI_API_KEY=sk-fake
  GOOSE_MODE=auto

