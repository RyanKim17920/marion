# Rust
/target/
**/*.rs.bk
*.pdb

# Tooling caches
.serena/
.cymbal/
.semble/

# marion runtime state (never commit — contains transcripts and prompts)
/state/
*.cast
*.jsonl

# Test fixtures are committed deliberately, but only after redaction review.
# See docs/specs/2026-07-31-marion-design.md §7.1 — fixtures contain system prompts,
# repo contents, and anything secret that appeared in tool output.
!tests/fixtures/**/*.jsonl
!tests/fixtures/**/*.cast

# Local env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
